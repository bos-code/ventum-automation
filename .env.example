# ─────────────────────────────────────────────────────────────────────────────
# Ventum Global Automation — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# Appwrite — client-safe (exposed to the browser)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Appwrite — server only (NEVER expose these)
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_PRODUCTS_COLLECTION_ID=products
APPWRITE_CATEGORIES_COLLECTION_ID=categories
APPWRITE_ENQUIRIES_COLLECTION_ID=enquiries
APPWRITE_SETTINGS_COLLECTION_ID=settings
APPWRITE_BUCKET_ID=product-images

# Telegram enquiry notifications — server only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin login (used only by `npm run seed` to bootstrap the first admin user)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site configuration
NEXT_PUBLIC_WHATSAPP_NUMBER=2348064870941
NEXT_PUBLIC_SITE_URL=https://ventumautomation.com
